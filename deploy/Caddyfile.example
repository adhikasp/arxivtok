arxivtok.example.com {
	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			transport http {
				response_header_timeout 60s   # LLM rewriting can be slow
			}
		}
	}
	handle {
		root * /srv/www/arxivtok           # contents of .output/public
		@assets path /_build/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
